# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection String
# Replace with your actual Atlas cluster connection URI:
# Example: mongodb+srv://admin:password123@cluster0.abcde.mongodb.net/vlogsphere?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://admin:password123@cluster0.abcde.mongodb.net/vlogsphere?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=vlogsphere_super_secret_jwt_key_2026_pro
JWT_EXPIRES_IN=30d

# Cloudinary Storage Credentials (Optional for local testing, required for cloud uploads)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456
